{
  "appId": "com.PlushLife",
  "appName": "PlushLife",
  "webDir": "www",
  "backgroundColor": "#fff0fa",
  "android": {
    "backgroundColor": "#fff0fa"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#fff0fa",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "LocalNotifications": {
      "smallIcon": "ic_notification_mascot"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "style": "LIGHT",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
