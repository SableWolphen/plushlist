<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/plushlife_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_mascot"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="🧸"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLUSH LIFE · TODAY"
                android:textAllCaps="false"
                android:textColor="#8C5B9A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="One little step ✨"
                android:textColor="#4F2E68"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#8B5A9C"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/plushlife_widget_task_row"
        android:text="Open PlushLife for one caring step"
        android:textColor="#4F405A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_task_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="9dp"
        android:background="@drawable/plushlife_widget_task_row"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_check_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#B34BC7"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_label_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="A caring step"
            android:textColor="#4F405A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="9dp"
        android:background="@drawable/plushlife_widget_task_row"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_check_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#B34BC7"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Another little step"
            android:textColor="#4F405A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="9dp"
        android:background="@drawable/plushlife_widget_task_row"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_task_check_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#B34BC7"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_label_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="One more if you want"
            android:textColor="#4F405A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Tap ○ to check it off · tiny steps count ✨"
        android:textColor="#8A708F"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_progress_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:padding="7dp"
            android:background="@drawable/plushlife_widget_mini_card">

            <TextView
                android:id="@+id/widget_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today 0%"
                android:textColor="#725981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:progress="0"
                android:progressTint="#B34BC7"
                android:progressBackgroundTint="#EADCF0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="7dp"
            android:background="@drawable/plushlife_widget_mini_card">

            <TextView
                android:id="@+id/widget_week_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Week 0%"
                android:textColor="#725981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_weekly_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:progress="0"
                android:progressTint="#61BFEA"
                android:progressBackgroundTint="#DCE9FA" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
