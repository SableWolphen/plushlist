<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/plushlife_widget_background">

    <TextView
        android:id="@+id/widget_day_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PlushLife · Today"
                android:textColor="#79508E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Open PlushLife for one caring step"
        android:textColor="#5B4B6B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_task_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5B4B6B"
        android:textSize="15sp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5B4B6B"
        android:textSize="15sp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_task_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5B4B6B"
        android:textSize="15sp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <!-- RemoteViews only supports a restricted set of widget classes.
         Do not add a plain <View> spacer here: Samsung One UI rejects the
         entire widget while inflating its preview/initial layout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/widget_today_label"
                android:text="Today"
                android:textAllCaps="false"
                android:textColor="#725981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:progress="0"
                android:progressTint="#A65DC1"
                android:progressBackgroundTint="#EADCF0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/widget_week_label"
                android:text="Week"
                android:textAllCaps="false"
                android:textColor="#725981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_weekly_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:progress="0"
                android:progressTint="#4C8FE8"
                android:progressBackgroundTint="#DCE9FA" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
