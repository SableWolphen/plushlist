{
  "configVersion": "v3",
  "app": {
    "appId": 10990001,
    "appName": "PlushLife",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "SableWolphen",
    "description": "Gentle PlushLife companion for Amazfit Balance 2"
  },
  "permissions": [
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.2",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "pages/index",
            "pages/checkin",
            "pages/rescue",
            "pages/focus",
            "pages/calm"
          ]
        }
      },
      "platforms": [
        { "st": "r", "sr": "w480" }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "PlushLife"
    }
  },
  "defaultLanguage": "en-US",
  "debug": true
}
