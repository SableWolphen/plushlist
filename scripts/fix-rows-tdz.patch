diff --git a/scripts/validate-app-source.js b/scripts/validate-app-source.js
index a1670bf..guardtdz 100644
--- a/scripts/validate-app-source.js
+++ b/scripts/validate-app-source.js
@@ -20,6 +20,18 @@ esbuild.buildSync({
   jsx: "transform",
 });
 
+// esbuild proves syntax/bundling, but it does not catch JavaScript temporal
+// dead-zone mistakes where a render-time expression reads a const before its
+// declaration. That exact class of bug can compile cleanly and still crash
+// React on first render. Guard the notification-action effect specifically.
+const rowsDeclarationIndex = appSource.indexOf("  const rows = scheduledTasksForView");
+const notificationActionEffectIndex = appSource.indexOf('document.addEventListener("plushlife-notification-task-action"');
+if (notificationActionEffectIndex !== -1 && (
+  rowsDeclarationIndex === -1 || notificationActionEffectIndex < rowsDeclarationIndex
+)) {
+  throw new Error("Runtime safety check failed: notification action effect references rows before rows is initialized.");
+}
